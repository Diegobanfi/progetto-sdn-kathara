# s2 - Access SDN switch
# Data ports: eth0 -> s1, eth1 -> h2 (web), eth2 -> h3 (db), eth4 -> s3
# Management: eth3 -> controller (NOT added to the OVS bridge)

/etc/init.d/openvswitch-switch start

ovs-vsctl add-br s2

# OpenFlow port numbers follow the order of the add-port commands
ovs-vsctl add-port s2 eth0   # OF port 1 (to s1)
ovs-vsctl add-port s2 eth1   # OF port 2 (to h2)
ovs-vsctl add-port s2 eth2   # OF port 3 (to h3)
ovs-vsctl add-port s2 eth4   # OF port 4 (to s3)

# Management interface: IP connectivity to the controller.
# Not part of the OVS bridge (control plane only).
ip addr add 172.16.0.20/24 dev eth3

ovs-vsctl set bridge s2 other-config:datapath-id=0000000000000002
# Connect to the Ryu controller over the management network
ovs-vsctl set-controller s2 tcp:172.16.0.1:6653
