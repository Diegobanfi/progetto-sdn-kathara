# r1 - Gateway router
# Bridges the external network (192.168.1.0/24) and the internal SDN
# network (10.0.0.0/24)

# External interface
ip addr add 192.168.1.1/24 dev eth0

# Internal interface (connects to the SDN domain through s1)
ip addr add 10.0.0.1/24 dev eth1

# Enable IP forwarding so that r1 acts as a router
sysctl -w net.ipv4.ip_forward=1
